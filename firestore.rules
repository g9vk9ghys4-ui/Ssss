rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user is authenticated admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Check if user owns this document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // App Settings:
    // Read: All authenticated users (to load ad block IDs, cooldowns, rewards)
    // Write: Strictly admins only
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admins Collection:
    // Read: Authenticated user checking their own admin document or existing admins
    // Write: Strictly admins only
    match /admins/{adminUid} {
      allow read: if request.auth != null && (request.auth.uid == adminUid || isAdmin());
      allow write: if isAdmin();
    }

    // Users Collection:
    // Normal users can read their own profile; admins can read all
    // Users cannot change their blocked status or tamper with other users
    match /users/{userId} {
      allow read: if request.auth != null && (isOwner(userId) || isAdmin());
      
      // Initial user profile creation
      allow create: if request.auth != null && (isOwner(userId) || isAdmin())
        && request.resource.data.isBlocked == false
        && request.resource.data.blocked == false;
      
      // Profile updates:
      // Admins have full access.
      // Normal users cannot unblock themselves or modify restricted fields.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked', 'blocked'])
      );
      
      allow delete: if isAdmin();
    }

    // Transactions Collection:
    // Normal users can only read their own transactions; admins can read all
    // Users cannot edit or delete existing transaction history
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || 
        resource.data.uid == request.auth.uid || 
        isAdmin()
      );
      
      allow create: if isAdmin() || (
        request.auth != null &&
        (request.resource.data.userId == request.auth.uid || request.resource.data.uid == request.auth.uid) &&
        request.resource.data.type in ['ad_reward', 'daily_bonus', 'referral_reward']
      );
      
      allow update, delete: if isAdmin();
    }
  }
}
